<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animation: the comet's head shoots in along its path and overshoots, then each trail stretches out
     behind it, middle first, and springs back. Runs 960ms (the first 200ms wait out the launch transition);
     keep windowSplashScreenAnimationDuration (values-v31/themes.xml) and SPLASH_MS in MainActivity in step.
     Geometry source: development/brand/logo/comet.py (local frame, rotated 45 degrees). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:translateX="54"
                android:translateY="54"
                android:rotation="45"
                android:scaleX="0.32"
                android:scaleY="0.32">
                <group android:name="head" android:pivotX="38" android:translateX="-170" android:scaleX="0.4" android:scaleY="0.4">
                    <path android:name="head_fill" android:fillAlpha="0" android:fillColor="@color/splash_mark"
                        android:pathData="M38,-44a44,44 0 1 1 0,88a44,44 0 1 1 0,-88Z" />
                </group>
                <group android:name="trail_mid" android:pivotX="-18" android:scaleX="0">
                    <path android:fillColor="@color/splash_mark" android:pathData="M-90,-12H-30a12,12 0 0 1 0,24H-90a12,12 0 0 1 0,-24Z" />
                </group>
                <group android:name="trail_top" android:pivotX="-2" android:scaleX="0">
                    <path android:fillColor="@color/splash_mark" android:pathData="M-48,-44H-12a10,10 0 0 1 0,20H-48a10,10 0 0 1 0,-20Z" />
                </group>
                <group android:name="trail_bot" android:pivotX="-2" android:scaleX="0">
                    <path android:fillColor="@color/splash_mark" android:pathData="M-48,24H-12a10,10 0 0 1 0,20H-48a10,10 0 0 1 0,-20Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="head">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="-170" android:valueTo="0"
                    android:duration="480" android:startOffset="200" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.4" android:valueTo="1"
                    android:duration="480" android:startOffset="200" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.4" android:valueTo="1"
                    android:duration="480" android:startOffset="200" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="head_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                    android:duration="200" android:startOffset="200" android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="trail_mid">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.3"
                    android:duration="220" android:startOffset="420" android:interpolator="@android:interpolator/linear_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.3" android:valueTo="1"
                    android:duration="180" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="trail_top">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.3"
                    android:duration="220" android:startOffset="490" android:interpolator="@android:interpolator/linear_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.3" android:valueTo="1"
                    android:duration="180" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="trail_bot">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.3"
                    android:duration="220" android:startOffset="560" android:interpolator="@android:interpolator/linear_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1.3" android:valueTo="1"
                    android:duration="180" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
