<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pull" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <style name="Theme.Pull.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pull</item>
    </style>
</resources>
